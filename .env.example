MONGODB_URI=mongodb://127.0.0.1:27017/foothub
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Paiement en ligne (facultatif : sans clé, seuls les paiements sur place et à la livraison sont proposés)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Si le compte Stripe n'accepte pas le TND : STRIPE_CURRENCY=eur et STRIPE_RATE_FROM_TND=0.30 par exemple
STRIPE_CURRENCY=tnd
STRIPE_RATE_FROM_TND=1

# Commission de FootHub sur les ventes des boutiques, en pourcentage
PLATFORM_COMMISSION_PERCENT=10

# E-mails de confirmation (facultatif : sans SMTP_HOST, l'envoi est ignoré et noté dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=FootHub <no-reply@example.com>
